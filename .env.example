# Şablon — gerçek değerler .env.local içinde (git'e girmez).
# Railway'de bu değişkenler proje ayarlarından tanımlanır.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sayac_takip
POSTGRES_USER=sayac_user
POSTGRES_PASSWORD=
# Yerel Postgres SSL istemez; hosted sağlayıcılarda (Neon, Railway) bu satırı silin.
POSTGRES_SSL=false

# --- Cihaz HTTP güvenlik anahtarı ---
# Boş bırakılırsa cihaz-yazan HTTP uçlarında auth KAPALIDIR.
# Tüm cihazlar MQTT'ye geçtikten sonra (Faz 6) bu değişken tamamen kaldırılacak.
API_SECRET_KEY=

# --- MQTT ---
# BOŞ BIRAKILIRSA MQTT TAMAMEN KAPALIDIR. Bu, serverless bir ortama (Vercel)
# yanlışlıkla deploy edildiğinde her cold start'ın brokera bağlanmasını engelleyen
# emniyettir — orada boş kalmalı.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Deployment başına benzersiz olmalı. İki örnek aynı clientId ile bağlanırsa
# broker birini düşürür ve flap döngüsü başlar.
MQTT_CLIENT_ID=sayac-backend
# Tek bir ücretsiz cluster'ı dev ve prod'un paylaşabilmesi için: lokalde sayac-dev.
MQTT_TOPIC_PREFIX=sayac

# Cihazlar YALNIZCA arayüzden (POST /api/devices) oluşturulsun mu?
# 1 = bilinmeyen device_id'den gelen okuma/sağlık/status reddedilir.
# Boş/0 = cihaz ilk veri gönderdiğinde otomatik oluşur (varsayılan).
MQTT_STRICT_DEVICES=

# --- Dashboard kimlik doğrulaması (src/proxy.ts) ---
# Tüm siteyi HTTP Basic auth arkasına alır. Cihaz uçları ve /api/health muaftır,
# yani bu değişkenler yanlış olsa bile cihazlar veri göndermeye devam eder.
# ÜRETİMDE ZORUNLU: tanımsızsa site 503 döner (sessizce korumasız çalışmaz).
# Geliştirmede tanımsız bırakılabilir, auth devre dışı kalır.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
